programa
{
	
	funcao inicio()
	{
			   inteiro v[5] 

			   	   para ( inteiro i=0; i<5; i++)

	   {

		  escreva("Valor ", i+1, ":")

		  leia(v[i])
		     }
		     	   para (inteiro i=4; i>-1; i--)

	   escreva (v[i], "\n")
}
}

